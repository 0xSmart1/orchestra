# Orchestra Backend — Environment Variables
# Copy this file to .env and fill in your values

DATABASE_URL=file:./orchestra.db

# LLM API key (required for chat/agent functionality)
# Convention: LLM_API_KEY_<PROVIDER_NAME> for per-provider keys
# Falls back to LLM_API_KEY if per-provider key not set
# For Anthropic providers: LLM_API_KEY_ANTHROPIC=sk-ant-...
LLM_API_KEY=your-llm-api-key-here
