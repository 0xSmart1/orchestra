# Orchestra — Environment Variables
# Copy this file to .env and fill in your values

# ─── Claude Code (if using as AI assistant) ───
CLAUDE_CODE_USE_OPENAI=1
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=your-model-here
CLAUDE_CODE_SUBAGENT_MODEL=your-model-here

# ─── Backend ───
DATABASE_URL=file:./orchestra.db

# ─── LLM Provider (OpenAI-compatible) ───
# Convention: LLM_API_KEY_<PROVIDER_NAME> for per-provider keys
# Falls back to LLM_API_KEY if per-provider key not set
LLM_API_KEY=your-llm-api-key-here
