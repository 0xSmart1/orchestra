// Standalone config — does NOT extend tsconfig.base.json because
// NestJS requires module:"commonjs" + moduleResolution:"node",
// which conflicts with the base's moduleResolution:"bundler".
// Keep this in sync with base options when updating shared settings.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@orchestra/shared": ["../shared/src"],
      "@orchestra/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
